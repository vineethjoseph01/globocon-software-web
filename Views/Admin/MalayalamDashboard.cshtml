@model IEnumerable<GloboconSoftwareWeb.Models.Video>

@{
    ViewData["Title"] = "Malayalam Showcase Admin Panel";
    int unreadCount = ViewBag.UnreadCount != null ? (int)ViewBag.UnreadCount : 0;
}

<div class="hero-section" style="padding: 2.5rem 2rem; background: linear-gradient(135deg, #051F6C 0%, #031448 100%);">
    <div class="section-container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span style="background: #00E5FF; color: #000414; font-weight: 800; font-size: 0.8rem; padding: 4px 10px; border-radius: 4px; display: inline-block; margin-bottom: 6px;">
                <i class="fas fa-language"></i> Malayalam Showcase Admin
            </span>
            <h1 class="hero-title" style="font-size: 2rem; margin: 0;">Malayalam Video Management</h1>
            <p style="color: #CBD5E1; font-size: 0.95rem; margin-top: 4px;">Manage Malayalam showcase videos published on the unlisted page (/Home/MalayalamWork).</p>
        </div>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a asp-controller="Admin" asp-action="CreateMalayalamVideo" class="btn-primary-custom" style="background: linear-gradient(135deg, #00E5FF 0%, #0052EA 100%); color: #000414; font-weight: 800;">
                <i class="fas fa-plus-circle"></i> + Add Malayalam Video
            </a>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn-outline-custom" style="color: #fff; border-color: rgba(255,255,255,0.4);">
                <i class="fas fa-desktop"></i> Main English Admin Panel
            </a>
            <a asp-controller="Home" asp-action="MalayalamWork" target="_blank" class="btn-dark-custom" style="border-color: #00E5FF; color: #00E5FF;">
                <i class="fas fa-external-link-alt"></i> View Malayalam Showcase
            </a>
            <form asp-controller="Admin" asp-action="Logout" method="post" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-outline-custom" style="color: #F87171; border-color: rgba(248,113,113,0.4);">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            </form>
        </div>
    </div>
</div>

<section class="section">
    <div class="section-container">

        <!-- Tab Navigation Bar between Admin Panels -->
        <div style="display: flex; gap: 1rem; margin-bottom: 2rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem;">
            <a asp-controller="Admin" asp-action="Dashboard" style="padding: 0.75rem 1.5rem; font-weight: 700; text-decoration: none; color: var(--text-muted); border-radius: 8px 8px 0 0;">
                <i class="fas fa-video"></i> English Main Showcase (@ViewBag.EnglishCount)
            </a>
            <a asp-controller="Admin" asp-action="MalayalamDashboard" style="padding: 0.75rem 1.5rem; font-weight: 800; text-decoration: none; color: var(--accent-blue); border-bottom: 3px solid var(--accent-blue); background: #EFF6FF; border-radius: 8px 8px 0 0;">
                <i class="fas fa-language"></i> Malayalam Unlisted Showcase (@Model.Count())
            </a>
        </div>
        
        <div style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color);">
                <div>
                    <h3 style="font-size: 1.35rem; font-weight: 800; color: var(--primary-navy);">Malayalam Showcase Library</h3>
                    <p style="font-size: 0.875rem; color: var(--text-muted);">These videos appear exclusively on the unlisted Malayalam Showcase page.</p>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <span class="badge-pill" style="font-size: 0.9rem; padding: 0.5rem 1rem; margin: 0; background: #00E5FF; color: #000414;">Total Malayalam Videos: @Model.Count()</span>
                    <a asp-controller="Admin" asp-action="CreateMalayalamVideo" class="btn-primary-custom" style="padding: 0.6rem 1.25rem; font-size: 0.95rem; background: linear-gradient(135deg, #00E5FF 0%, #0052EA 100%); color: #000414; font-weight: 800;">
                        <i class="fas fa-plus-circle"></i> + Add Malayalam Video
                    </a>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div style="text-align: center; padding: 3rem 1rem;">
                    <i class="fas fa-language" style="font-size: 3rem; color: var(--text-light); margin-bottom: 1rem;"></i>
                    <p style="color: var(--text-muted); margin-bottom: 1rem;">No Malayalam videos currently uploaded.</p>
                    <a asp-controller="Admin" asp-action="CreateMalayalamVideo" class="btn-primary-custom">Upload First Malayalam Video</a>
                </div>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
                        <thead>
                            <tr style="background: var(--bg-light); border-bottom: 2px solid var(--border-color);">
                                <th style="padding: 1rem; color: var(--primary-navy);">Preview</th>
                                <th style="padding: 1rem; color: var(--primary-navy);">Title</th>
                                <th style="padding: 1rem; color: var(--primary-navy);">Order</th>
                                <th style="padding: 1rem; color: var(--primary-navy);">Upload Date</th>
                                <th style="padding: 1rem; color: var(--primary-navy); text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var video in Model)
                            {
                                <tr style="border-bottom: 1px solid var(--border-color);">
                                    <td style="padding: 0.75rem 1rem; width: 110px;">
                                        <div style="width: 90px; height: 60px; background: #000; border-radius: 6px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                            <video style="width: 100%; height: 100%; object-fit: contain;" preload="metadata" muted>
                                                <source src="@video.FilePath#t=0.5" type="video/mp4">
                                            </video>
                                        </div>
                                    </td>
                                    <td style="padding: 0.75rem 1rem; font-weight: 600; color: var(--primary-navy);">
                                        @video.Title
                                        <br>
                                        <small style="color: var(--text-light); font-weight: normal;">@video.FilePath</small>
                                    </td>
                                    <td style="padding: 0.75rem 1rem;">
                                        <span style="background: #00E5FF; color: #000414; padding: 4px 10px; border-radius: 4px; font-weight: 800;">#@video.DisplayOrder</span>
                                    </td>
                                    <td style="padding: 0.75rem 1rem; color: var(--text-muted);">
                                        @video.UploadDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>
                                    <td style="padding: 0.75rem 1rem; text-align: right;">
                                        <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
                                            <a asp-controller="Admin" asp-action="EditVideo" asp-route-id="@video.Id" class="btn-outline-custom" style="padding: 0.4rem 0.8rem; font-size: 0.85rem;">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form asp-controller="Admin" asp-action="DeleteVideo" asp-route-id="@video.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this Malayalam video?');" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" style="background: #FEE2E2; color: #DC2626; border: 1px solid #FCA5A5; padding: 0.4rem 0.8rem; border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 600; cursor: pointer;">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</section>
