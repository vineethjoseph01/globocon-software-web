}

<div class="hero-section">
    <div class="hero-container">
        <div>
            <span class="hero-badge"><i class="fas fa-cogs"></i> Engineering Services</span>
            <h1 class="hero-title">AI-Powered Software Services</h1>
            <p class="hero-tagline">
                Globocon Software Australia specializes in developing custom digital solutions using Artificial Intelligence, modern frameworks, and cloud architecture.
            </p>
            <div class="hero-actions">
                <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom">Schedule Technical Consultation</a>
                <a asp-controller="Home" asp-action="Work" class="btn-dark-custom">View Case Studies</a>
            </div>
        </div>
        <div class="hero-card-preview">
            <div class="hero-stats">
                <div>
                    <span class="stat-number">100%</span>
                    <span class="stat-label">Australian Compliant</span>
                </div>
                <div>
                    <span class="stat-number">60%</span>
                    <span class="stat-label">Faster Deployment</span>
                </div>
                <div>
                    <span class="stat-number">24/7</span>
                    <span class="stat-label">Enterprise Support</span>
                </div>
                <div>
                    <span class="stat-number">Sydney</span>
                    <span class="stat-label">&amp; Melbourne HQ</span>
                </div>
            </div>
        </div>
    </div>
</div>

