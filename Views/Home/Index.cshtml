@using System.Web

<!-- Featured Work Preview -->
@if (featuredVideos.Any())
{
    <section class="section section-light">
        <div class="section-container">
            <div class="section-header">
                <span class="section-subtitle">Our Work Showcase</span>
                <h2 class="section-title">See Our Products in Action</h2>
                <p class="section-desc">Watch video previews of solutions engineered by Globocon Software Australia.</p>
            </div>

            <div class="video-grid">
                @foreach (var video in featuredVideos)
                {
                    var encodedTitle = HttpUtility.JavaScriptStringEncode(video.Title);
                    <div class="video-card" onclick="openVideoModal('@video.FilePath', '@encodedTitle')">
                        <div class="video-thumbnail-wrapper">
                            <video class="video-preview-element" preload="metadata" muted playsinline>
                                <source src="@video.FilePath#t=0.5" type="video/mp4">
                            </video>
                            <div class="play-overlay-btn"><i class="fas fa-play"></i></div>
                        </div>
                        <div class="video-info">
                            <h4 class="video-card-title">@video.Title</h4>
                            <div class="video-meta">
                                <span><i class="far fa-calendar-alt"></i> @video.UploadDate.ToString("MMM dd, yyyy")</span>
                                <span style="margin-left: auto; color: var(--accent-blue); font-weight: 700;">Play Video <i class="fas fa-play-circle"></i></span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div style="text-align: center; margin-top: 2.25rem;">
                <a asp-controller="Home" asp-action="Work" class="btn-dark-custom">
                    View Complete Video Showcase <i class="fas fa-video"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- FAQ Accordion Section (Inspired by Confident Care Group) -->
<section class="section section-light">
    <div class="section-container">
        <div class="section-header">
            <span class="section-subtitle">Frequently Asked Questions</span>
            <h2 class="section-title">Everything You Need to Know About Globocon AI Solutions</h2>
            <p class="section-desc">Got questions about how our software engineering team builds custom web, mobile, and AI products?</p>
        </div>

        <div class="faq-container">
            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">
                    <span>How fast can Globocon Software Australia launch a custom AI solution?</span>
                    <i class="fas fa-chevron-down faq-icon"></i>
                </div>
                <div class="faq-answer">
                    By leveraging our pre-built AI product frameworks (SmartRoster AI, Virtual Hospital AI, Smart Tax Booking AI), we can deploy fully tailored enterprise applications in 60% less time than traditional agencies.
                </div>
            </div>

            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">
                    <span>Are your software engineering practices aligned with Australian compliance standards?</span>
                    <i class="fas fa-chevron-down faq-icon"></i>
                </div>
                <div class="faq-answer">
                    Yes. All software systems built by Globocon adhere strictly to Australian Privacy Principles (APPs), local data encryption requirements, and Australian cloud hosting standards in Sydney and Melbourne.
                </div>
            </div>

            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">
                    <span>Can Globocon integrate with our existing ERP or accounting software?</span>
                    <i class="fas fa-chevron-down faq-icon"></i>
                </div>
                <div class="faq-answer">
                    Absolutely. We specialize in seamless REST and GraphQL API integrations for Xero, MYOB, QuickBooks, Salesforce, Microsoft 365, and custom legacy SQL databases.
                </div>
            </div>

            <div class="faq-item">
                <div class="faq-question" onclick="toggleFaq(this)">
                    <span>How does Globocon ensure secure authentication and data protection?</span>
                    <i class="fas fa-chevron-down faq-icon"></i>
                </div>
                <div class="faq-answer">
                    We implement multi-factor authentication (MFA/2FA), IP rate limiting, Cloudflare Turnstile anti-bot verification, encrypted databases, and role-based access control (RBAC).
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FAQPage JSON-LD Schema for SERP Rich Snippets -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "FAQPage",
  "mainEntity": [
    {
      "@@type": "Question",
      "name": "How fast can Globocon Software Australia launch a custom AI solution?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "By leveraging our pre-built AI product frameworks (SmartRoster AI, Virtual Hospital AI, Smart Tax Booking AI), we can deploy fully tailored enterprise applications in 60% less time than traditional agencies."
      }
    },
    {
      "@@type": "Question",
      "name": "Are your software engineering practices aligned with Australian compliance standards?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes. All software systems built by Globocon adhere strictly to Australian Privacy Principles (APPs), local data encryption requirements, and Australian cloud hosting standards in Sydney and Melbourne."
      }
    },
    {
      "@@type": "Question",
      "name": "Can Globocon integrate with our existing ERP or accounting software?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Absolutely. We specialize in seamless REST and GraphQL API integrations for Xero, MYOB, QuickBooks, Salesforce, Microsoft 365, and custom legacy SQL databases."
      }
    },
    {
      "@@type": "Question",
      "name": "How does Globocon ensure secure authentication and data protection?",
      "acceptedAnswer": {
        "@@type": "Answer",
        "text": "We implement multi-factor authentication (MFA/2FA), IP rate limiting, Cloudflare Turnstile anti-bot verification, encrypted databases, and role-based access control (RBAC)."
      }
    }
  ]
}
</script>

<!-- CTA Banner -->
<section class="section">
    <div class="section-container">
        <div class="cta-banner">
            <h2 class="cta-title">Turn Your Idea Into Reality</h2>
            <p class="cta-desc">Have an idea for an AI-powered product or custom enterprise software solution? Contact Globocon Software Australia today.</p>
            <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom" style="padding: 1rem 2rem; font-size: 1.05rem;">
                Start Your Project <i class="fas fa-paper-plane"></i>
            </a>
        </div>
    </div>
</section>

<!-- Video Lightbox Modal -->
<div class="modal-backdrop-custom" id="globalVideoModal">
    <div class="modal-box">
        <div class="modal-header-bar">
            <div class="modal-title" id="globalVideoTitle">Video Showcase</div>
            <button class="modal-close-btn" onclick="closeVideoModal()">&times;</button>
        </div>
        <div class="modal-video-wrapper">
            <video class="modal-video-element" id="globalVideoPlayer" controls playsinline autoplay>
                <source id="globalVideoSource" src="" type="video/mp4">
                Your browser does not support HTML5 video playback.
            </video>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const techData = {
            ai: {
                title: '<i class="fas fa-brain"></i> Artificial Intelligence & Machine Learning',
                desc: 'We build custom Machine Learning models, natural language understanding engines, predictive analytics, and autonomous AI agents designed to automate complex corporate workflows and enhance decision-making.',
                pills: ['Custom LLMs & RAG', 'Predictive Analytics', 'Natural Language Processing', 'Computer Vision & OCR']
            },
            cloud: {
                title: '<i class="fas fa-cloud-upload-alt"></i> Enterprise Cloud Computing',
                desc: 'High-availability serverless architectures, multi-region cloud deployment on AWS/Azure, and containerized microservices ensuring 99.99% uptime and elastic scalability for growing enterprise workloads.',
                pills: ['AWS & Azure Cloud', 'Serverless Microservices', 'Auto-Scaling Infrastructure', 'Docker & Kubernetes']
            },
            web: {
                title: '<i class="fas fa-code"></i> High-Performance Web Applications',
                desc: 'Custom ASP.NET Core & Node.js web platforms featuring real-time data streaming, responsive multi-device layouts, automated customer self-service portals, and high-security compliance.',
                pills: ['ASP.NET Core 8 MVC', 'Node.js & Express', 'Real-Time Dashboards', 'Customer Self-Service Portals']
            },
            mobile: {
                title: '<i class="fas fa-mobile-alt"></i> Native & Cross-Platform Mobile Apps',
                desc: 'Sleek iOS and Android mobile solutions built for field service management, workforce scheduling, logistics, and real-time push notifications with offline data synchronization.',
                pills: ['iOS & Android Apps', 'Offline Data Sync', 'GPS & Geofencing', 'Push Notification Engine']
            },
            saas: {
                title: '<i class="fas fa-layer-group"></i> Multi-Tenant SaaS Platforms',
                desc: 'End-to-end SaaS engineering including multi-tenant database isolation, automated tier subscription billing via Stripe, enterprise user roles, and white-label customization.',
                pills: ['Multi-Tenant Database', 'Stripe Billing & Subscriptions', 'RBAC Security Roles', 'White-Label Portals']
            },
            api: {
                title: '<i class="fas fa-diagram-project"></i> Third-Party APIs & System Integration',
                desc: 'Seamlessly connect disparate legacy platforms with modern cloud applications via RESTful APIs, Webhooks, Xero, MYOB, Salesforce, and Microsoft 365 integrations.',
                pills: ['Xero & MYOB Sync', 'Salesforce & CRM Integration', 'RESTful API Engineering', 'Webhooks & Message Queues']
            },
            db: {
                title: '<i class="fas fa-database"></i> High-Speed Database Solutions',
                desc: 'Optimized SQL Server, PostgreSQL, and Redis caching solutions designed for sub-millisecond query performance, automated daily backups, and strict Australian Privacy Principle compliance.',
                pills: ['SQL Server & PostgreSQL', 'Redis In-Memory Caching', 'Sub-millisecond Queries', 'Automated Encrypted Backups']
            },
            automation: {
                title: '<i class="fas fa-cogs"></i> Enterprise Automation Systems',
                desc: 'Eliminate repetitive operational overhead with automated background job queues, document parsing pipelines, automated email/SMS reminders, and real-time audit logging.',
                pills: ['Background Worker Queues', 'Automated PDF Parsing', 'SMS & Email Triggers', 'Real-Time Audit Logging']
            }
        };

        function selectTechCapability(key, btn) {
            document.querySelectorAll('.tech-tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const data = techData[key];
            if (data) {
                document.getElementById('techDetailTitle').innerHTML = data.title;
                document.getElementById('techDetailDesc').textContent = data.desc;
                document.getElementById('techFeaturePills').innerHTML = data.pills.map(p => `<span class="tech-pill">${p}</span>`).join('');
            }
        }

        function toggleFaq(element) {
            const item = element.parentElement;
            item.classList.toggle('active');
        }

        function openVideoModal(videoUrl, title) {
            const modal = document.getElementById('globalVideoModal');
            const player = document.getElementById('globalVideoPlayer');
            const source = document.getElementById('globalVideoSource');
            const titleEl = document.getElementById('globalVideoTitle');

            titleEl.textContent = title;
            source.src = videoUrl;
            player.load();
            modal.classList.add('active');
            player.play();
        }

        function closeVideoModal() {
            const modal = document.getElementById('globalVideoModal');
            const player = document.getElementById('globalVideoPlayer');
            player.pause();
            modal.classList.remove('active');
        }

        document.getElementById('globalVideoModal')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeVideoModal();
            }
        });
    </script>
}
