            </p>
            <div class="hero-actions">
                <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom">
                    Consult Our AI Experts <i class="fas fa-arrow-right"></i>
                </a>
                <a asp-controller="Home" asp-action="Work" class="btn-outline-custom">
                    <i class="fas fa-play-circle" style="color: var(--accent-blue);"></i> Watch Showcase
                </a>
            </div>
        </div>
        <div>
            <div class="hero-card-preview">
                <h3 style="font-size: 1.25rem; font-weight: 900; color: #fff; margin-bottom: 1.25rem;">The Globocon Advantage</h3>
                <div class="hero-stats">
                    <div class="stat-item">
                        <span class="stat-number">60%</span>
                        <span class="stat-label">Faster Development</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">100%</span>
                        <span class="stat-label">Australian Standards</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">5+</span>
                        <span class="stat-label">Flagship AI Products</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">24/7</span>
                        <span class="stat-label">Automated Efficiency</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services Overview -->
