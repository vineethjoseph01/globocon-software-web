@{
    ViewData["Title"] = "About Globocon Software Australia";
}

<div class="hero-section">
    <div class="hero-container">
        <div>
            <span class="hero-badge"><i class="fas fa-building"></i> About Globocon</span>
            <h1 class="hero-title">Empowering Australian Enterprise with AI</h1>
            <p class="hero-tagline">
                Globocon Software Australia helps businesses transform ideas into powerful digital solutions using Artificial Intelligence, modern software practices, and cloud technologies.
            </p>
            <div class="hero-actions">
                <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom">Contact Our Executive Team</a>
                <a asp-controller="Home" asp-action="Services" class="btn-dark-custom">View Engineering Services</a>
            </div>
        </div>
        <div class="hero-card-preview">
            <div class="hero-stats">
                <div>
                    <span class="stat-number">2026</span>
                    <span class="stat-label">AI Innovations</span>
                </div>
                <div>
                    <span class="stat-number">100%</span>
                    <span class="stat-label">Australian Owned</span>
                </div>
                <div>
                    <span class="stat-number">2</span>
                    <span class="stat-label">Sydney &amp; Melbourne</span>
                </div>
                <div>
                    <span class="stat-number">APP</span>
                    <span class="stat-label">Strict Compliance</span>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="section">
    <div class="section-container">

        <!-- Why Choose Globocon -->
        <div class="section-header">
            <span class="section-subtitle">Core Philosophy</span>
            <h2 class="section-title">Why Choose Globocon Software?</h2>
        </div>

        <div class="cards-grid" style="margin-bottom: 4rem;">
            <div class="card-custom">
                <div class="card-icon"><i class="fas fa-brain"></i></div>
                <h3 class="card-title">AI-First Development</h3>
                <p class="card-text">We leverage Artificial Intelligence throughout the software lifecycle to accelerate build times, eliminate manual overhead, and deliver cost-effective solutions.</p>
                <ul class="card-list">
                    <li>Reduce development time</li>
                    <li>Improve developer productivity</li>
                    <li>Deliver cost-effective solutions</li>
                    <li>Accelerate market innovation</li>
                </ul>
            </div>

            <div class="card-custom">
                <div class="card-icon"><i class="fas fa-briefcase"></i></div>
                <h3 class="card-title">Deep Industry Experience</h3>
                <p class="card-text">Our team brings domain experience delivering complex software platforms across critical commercial sectors.</p>
                <ul class="card-list">
                    <li>Healthcare &amp; NDIS</li>
                    <li>Security &amp; Logistics</li>
                    <li>Workforce Management</li>
                    <li>Education &amp; Hospitality</li>
                </ul>
            </div>

            <div class="card-custom">
                <div class="card-icon"><i class="fas fa-flag-checkered"></i></div>
                <h3 class="card-title">Australian Business Understanding</h3>
                <p class="card-text">Based in Australia, we understand local business requirements, privacy laws, compliance expectations (NDIS, ATO, AHPRA), and market dynamics.</p>
                <ul class="card-list">
                    <li>Sydney &amp; Melbourne teams</li>
                    <li>Local compliance adherence</li>
                    <li>Direct account management</li>
                    <li>On-shore quality assurance</li>
                </ul>
            </div>
        </div>

        <!-- 5-Step Process -->
        <div style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 3.5rem; margin-bottom: 4rem; box-shadow: var(--shadow-sm);">
            <div class="section-header">
                <span class="section-subtitle">Methodology</span>
                <h2 class="section-title">Our Development Process</h2>
                <p class="section-desc">A structured 5-step engineering framework from concept to continuous growth.</p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
                <div style="background: var(--bg-light); border-radius: var(--radius-md); padding: 1.5rem; border-left: 4px solid var(--primary-navy);">
                    <div style="font-size: 2rem; font-weight: 800; color: var(--accent-blue); margin-bottom: 0.5rem;">01</div>
                    <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--primary-navy); margin-bottom: 0.5rem;">Understand Your Idea</h4>
                    <p style="font-size: 0.875rem; color: var(--text-muted);">We thoroughly analyse your business goals, user personas, and technical requirements.</p>
                </div>

                <div style="background: var(--bg-light); border-radius: var(--radius-md); padding: 1.5rem; border-left: 4px solid var(--accent-blue);">
                    <div style="font-size: 2rem; font-weight: 800; color: var(--accent-blue); margin-bottom: 0.5rem;">02</div>
                    <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--primary-navy); margin-bottom: 0.5rem;">AI-Powered Planning</h4>
                    <p style="font-size: 0.875rem; color: var(--text-muted);">We identify automation opportunities to maximize operational efficiency and cut costs.</p>
                </div>

                <div style="background: var(--bg-light); border-radius: var(--radius-md); padding: 1.5rem; border-left: 4px solid var(--primary-navy);">
                    <div style="font-size: 2rem; font-weight: 800; color: var(--accent-blue); margin-bottom: 0.5rem;">03</div>
                    <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--primary-navy); margin-bottom: 0.5rem;">Rapid Development</h4>
                    <p style="font-size: 0.875rem; color: var(--text-muted);">Engineering the solution using modern stack frameworks and AI-assisted development tools.</p>
                </div>

                <div style="background: var(--bg-light); border-radius: var(--radius-md); padding: 1.5rem; border-left: 4px solid var(--accent-blue);">
                    <div style="font-size: 2rem; font-weight: 800; color: var(--accent-blue); margin-bottom: 0.5rem;">04</div>
                    <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--primary-navy); margin-bottom: 0.5rem;">Testing &amp; Deployment</h4>
                    <p style="font-size: 0.875rem; color: var(--text-muted);">Rigorous automated security testing followed by seamless cloud deployment.</p>
                </div>

                <div style="background: var(--bg-light); border-radius: var(--radius-md); padding: 1.5rem; border-left: 4px solid var(--primary-navy);">
                    <div style="font-size: 2rem; font-weight: 800; color: var(--accent-blue); margin-bottom: 0.5rem;">05</div>
                    <h4 style="font-size: 1.1rem; font-weight: 700; color: var(--primary-navy); margin-bottom: 0.5rem;">Continuous Improvement</h4>
                    <p style="font-size: 0.875rem; color: var(--text-muted);">Regular feature enhancements and performance optimizations as your business expands.</p>
                </div>
            </div>
        </div>

        <!-- Technology Expertise Interactive Section (Moved from Home page to last section of About Us) -->
        <div style="background: linear-gradient(135deg, #000414 0%, #010826 50%, #041852 100%); color: #fff; padding: clamp(2.5rem, 4vw, 3.5rem); border-radius: var(--radius-lg); border: 2px solid var(--accent-cyan); box-shadow: var(--shadow-lg);">
            <div class="section-header" style="margin-bottom: 2rem;">
                <span class="section-subtitle" style="color: var(--accent-cyan);">Capabilities</span>
                <h2 class="section-title" style="color: #fff;">Technology Expertise</h2>
                <p class="section-desc" style="color: #CBD5E1;">Explore our core engineering capabilities across AI, cloud, mobile, and enterprise automation.</p>
            </div>

            <div class="tech-capabilities-box">
                <div class="tech-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.75rem;">
                    <button type="button" class="tech-tab-btn active" onclick="selectTechCapability('ai', this)">
                        <i class="fas fa-brain"></i>
                        <span>Artificial Intelligence</span>
                    </button>
                    <button type="button" class="tech-tab-btn" onclick="selectTechCapability('cloud', this)">
                        <i class="fas fa-cloud-upload-alt"></i>
                        <span>Cloud Computing</span>
                    </button>
                    <button type="button" class="tech-tab-btn" onclick="selectTechCapability('web', this)">
                        <i class="fas fa-code"></i>
                        <span>Web Applications</span>
                    </button>
                    <button type="button" class="tech-tab-btn" onclick="selectTechCapability('mobile', this)">
                        <i class="fas fa-mobile-alt"></i>
                        <span>Mobile Applications</span>
                    </button>
                    <button type="button" class="tech-tab-btn" onclick="selectTechCapability('saas', this)">
                        <i class="fas fa-layer-group"></i>
                        <span>SaaS Platforms</span>
                    </button>
                    <button type="button" class="tech-tab-btn" onclick="selectTechCapability('api', this)">
                        <i class="fas fa-diagram-project"></i>
                        <span>APIs &amp; Integrations</span>
                    </button>
                    <button type="button" class="tech-tab-btn" onclick="selectTechCapability('db', this)">
                        <i class="fas fa-database"></i>
                        <span>Database Solutions</span>
                    </button>
                    <button type="button" class="tech-tab-btn" onclick="selectTechCapability('automation', this)">
                        <i class="fas fa-cogs"></i>
                        <span>Automation Systems</span>
                    </button>
                </div>

                <div class="tech-detail-card" id="aboutTechDetailCard" style="background: rgba(255, 255, 255, 0.08); border: 2px solid var(--accent-cyan); border-radius: var(--radius-md); padding: 2rem 2.25rem; backdrop-filter: blur(12px);">
                    <h3 class="tech-detail-title" id="aboutTechDetailTitle" style="font-size: 1.45rem; font-weight: 900; color: #00E5FF; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.6rem;">
                        <i class="fas fa-brain"></i> Artificial Intelligence &amp; Machine Learning
                    </h3>
                    <p class="tech-detail-desc" id="aboutTechDetailDesc" style="font-size: 1.02rem; color: #F1F5F9; line-height: 1.65; margin-bottom: 1.25rem;">
                        We build custom Machine Learning models, natural language understanding engines, predictive analytics, and autonomous AI agents designed to automate complex corporate workflows and enhance decision-making.
                    </p>
                    <div class="tech-feature-pills" id="aboutTechFeaturePills" style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                        <span class="tech-pill" style="background: rgba(0, 229, 255, 0.18); border: 1.5px solid #00E5FF; color: #FFFFFF; font-weight: 700; padding: 0.4rem 1rem; border-radius: 999px;">Custom LLMs &amp; RAG</span>
                        <span class="tech-pill" style="background: rgba(0, 229, 255, 0.18); border: 1.5px solid #00E5FF; color: #FFFFFF; font-weight: 700; padding: 0.4rem 1rem; border-radius: 999px;">Predictive Analytics</span>
                        <span class="tech-pill" style="background: rgba(0, 229, 255, 0.18); border: 1.5px solid #00E5FF; color: #FFFFFF; font-weight: 700; padding: 0.4rem 1rem; border-radius: 999px;">Natural Language Processing</span>
                        <span class="tech-pill" style="background: rgba(0, 229, 255, 0.18); border: 1.5px solid #00E5FF; color: #FFFFFF; font-weight: 700; padding: 0.4rem 1rem; border-radius: 999px;">Computer Vision &amp; OCR</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        const aboutTechData = {
            ai: {
                title: '<i class="fas fa-brain"></i> Artificial Intelligence & Machine Learning',
                desc: 'We build custom Machine Learning models, natural language understanding engines, predictive analytics, and autonomous AI agents designed to automate complex corporate workflows and enhance decision-making.',
                pills: ['Custom LLMs & RAG', 'Predictive Analytics', 'Natural Language Processing', 'Computer Vision & OCR']
            },
            cloud: {
                title: '<i class="fas fa-cloud-upload-alt"></i> Enterprise Cloud Computing',
                desc: 'High-availability serverless architectures, multi-region cloud deployment on AWS/Azure, and containerized microservices ensuring 99.99% uptime and elastic scalability for growing enterprise workloads.',
                pills: ['AWS & Azure Cloud', 'Serverless Microservices', 'Auto-Scaling Infrastructure', 'Docker & Kubernetes']
            },
            web: {
                title: '<i class="fas fa-code"></i> High-Performance Web Applications',
                desc: 'Custom ASP.NET Core & Node.js web platforms featuring real-time data streaming, responsive multi-device layouts, automated customer self-service portals, and high-security compliance.',
                pills: ['ASP.NET Core 8 MVC', 'Node.js & Express', 'Real-Time Dashboards', 'Customer Self-Service Portals']
            },
            mobile: {
                title: '<i class="fas fa-mobile-alt"></i> Native & Cross-Platform Mobile Apps',
                desc: 'Sleek iOS and Android mobile solutions built for field service management, workforce scheduling, logistics, and real-time push notifications with offline data synchronization.',
                pills: ['iOS & Android Apps', 'Offline Data Sync', 'GPS & Geofencing', 'Push Notification Engine']
            },
            saas: {
                title: '<i class="fas fa-layer-group"></i> Multi-Tenant SaaS Platforms',
                desc: 'End-to-end SaaS engineering including multi-tenant database isolation, automated tier subscription billing via Stripe, enterprise user roles, and white-label customization.',
                pills: ['Multi-Tenant Database', 'Stripe Billing & Subscriptions', 'RBAC Security Roles', 'White-Label Portals']
            },
            api: {
                title: '<i class="fas fa-diagram-project"></i> Third-Party APIs & System Integration',
                desc: 'Seamlessly connect disparate legacy platforms with modern cloud applications via RESTful APIs, Webhooks, Xero, MYOB, Salesforce, and Microsoft 365 integrations.',
                pills: ['Xero & MYOB Sync', 'Salesforce & CRM Integration', 'RESTful API Engineering', 'Webhooks & Message Queues']
            },
            db: {
                title: '<i class="fas fa-database"></i> High-Speed Database Solutions',
                desc: 'Optimized SQL Server, PostgreSQL, and Redis caching solutions designed for sub-millisecond query performance, automated daily backups, and strict Australian Privacy Principle compliance.',
                pills: ['SQL Server & PostgreSQL', 'Redis In-Memory Caching', 'Sub-millisecond Queries', 'Automated Encrypted Backups']
            },
            automation: {
                title: '<i class="fas fa-cogs"></i> Enterprise Automation Systems',
                desc: 'Eliminate repetitive operational overhead with automated background job queues, document parsing pipelines, automated email/SMS reminders, and real-time audit logging.',
                pills: ['Background Worker Queues', 'Automated PDF Parsing', 'SMS & Email Triggers', 'Real-Time Audit Logging']
            }
        };

        function selectTechCapability(key, btn) {
            document.querySelectorAll('.tech-tab-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            const data = aboutTechData[key];
            if (data) {
                document.getElementById('aboutTechDetailTitle').innerHTML = data.title;
                document.getElementById('aboutTechDetailDesc').textContent = data.desc;
                document.getElementById('aboutTechFeaturePills').innerHTML = data.pills.map(p => `<span class="tech-pill" style="background: rgba(0, 229, 255, 0.18); border: 1.5px solid #00E5FF; color: #FFFFFF; font-weight: 700; padding: 0.4rem 1rem; border-radius: 999px;">${p}</span>`).join('');
            }
        }
    </script>
}
