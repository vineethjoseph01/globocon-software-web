@{
    ViewData["Title"] = "Our AI Products";
}

<div class="hero-section">
    <div class="hero-container">
        <div>
            <span class="hero-badge"><i class="fas fa-microchip"></i> Globocon AI Product Line</span>
            <h1 class="hero-title">Intelligent Industry Platforms</h1>
            <p class="hero-tagline">
                Pre-built, customizable AI products engineered to transform workforce management, healthcare, education, hospitality, and financial operations.
            </p>
            <div class="hero-actions">
                <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom">Request AI Product Demo</a>
                <a asp-controller="Home" asp-action="Work" class="btn-dark-custom">Watch Video Demos</a>
            </div>
        </div>
        <div class="hero-card-preview">
            <div class="hero-stats">
                <div>
                    <span class="stat-number">5+</span>
                    <span class="stat-label">AI Platforms</span>
                </div>
                <div>
                    <span class="stat-number">60%</span>
                    <span class="stat-label">Faster Rollout</span>
                </div>
                <div>
                    <span class="stat-number">100%</span>
                    <span class="stat-label">Customizable</span>
                </div>
                <div>
                    <span class="stat-number">APP</span>
                    <span class="stat-label">Privacy Compliant</span>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="section">
    <div class="section-container">

        <!-- Product 1: SmartRoster AI -->
        <div style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 3rem; margin-bottom: 3rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
                <div>
                    <span class="badge-pill" style="background: #DBEAFE; color: var(--accent-blue);">Flagship Workforce Platform</span>
                    <h2 style="font-size: 2rem; font-weight: 800; color: var(--primary-navy); margin-top: 0.5rem;">SmartRoster AI</h2>
                    <p style="font-size: 1.1rem; color: var(--accent-blue); font-weight: 600;">Intelligent Workforce Management &amp; Rostering Platform</p>
                </div>
                <a asp-controller="Home" asp-action="Contact" class="btn-primary-custom">Request Product Demo</a>
            </div>

            <p style="font-size: 1rem; color: var(--text-muted); margin-bottom: 2rem;">
                SmartRoster AI helps organisations create efficient staff schedules using artificial intelligence, drastically reducing manual scheduling hours and avoiding costly compliance errors.
            </p>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                <div>
                    <h4 style="font-size: 1rem; font-weight: 700; color: var(--primary-navy); margin-bottom: 1rem;"><i class="fas fa-sliders" style="color: var(--accent-blue);"></i> Core Features:</h4>
                    <ul class="card-list" style="border: none; padding: 0;">
                        <li>AI-based automated roster generation</li>
                        <li>Employee availability &amp; leave management</li>
                        <li>Location-based shift allocation &amp; geofencing</li>
                        <li>Skills, certifications &amp; compliance matching</li>
                        <li>Automated shift notifications (SMS/Push)</li>
                        <li>Timesheet management &amp; GPS verification</li>
                        <li>Direct Payroll integration (Xero/MYOB/KeyPay)</li>
                        <li>Workforce analytics &amp; labor cost prediction</li>
                    </ul>
                </div>
                <div style="background: var(--bg-light); padding: 1.75rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                    <h4 style="font-size: 1rem; font-weight: 700; color: var(--primary-navy); margin-bottom: 1rem;"><i class="fas fa-users" style="color: var(--accent-blue);"></i> Designed for:</h4>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                        <span class="badge-pill" style="background:#fff;">Healthcare providers</span>
                        <span class="badge-pill" style="background:#fff;">NDIS organisations</span>
                        <span class="badge-pill" style="background:#fff;">Security companies</span>
                        <span class="badge-pill" style="background:#fff;">Cleaning companies</span>
                        <span class="badge-pill" style="background:#fff;">Hospitality businesses</span>
                        <span class="badge-pill" style="background:#fff;">Field service teams</span>
                    </div>
                </div>
            </div>
        </div>

