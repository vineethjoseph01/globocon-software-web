@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="hero-section" style="padding: 3.5rem 2rem; background: linear-gradient(135deg, #051F6C 0%, #082A8F 100%);">
    <div class="section-container" style="text-align: center;">
        <span class="hero-badge"><i class="fas fa-shield-alt"></i> Data Protection</span>
        <h1 class="hero-title" style="font-size: 2.5rem; margin-top: 0.5rem;">Privacy Policy</h1>
        <p class="hero-tagline" style="margin: 0 auto; max-width: 700px;">
            Globocon Software Australia is committed to respecting your privacy and protecting your personal data in accordance with the Australian Privacy Principles (APPs).
        </p>
    </div>
</div>

<section class="section">
    <div class="section-container" style="max-width: 900px; background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 3rem; box-shadow: var(--shadow-sm);">
        
        <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--primary-navy); margin-bottom: 1rem;">1. Information We Collect</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
            When you use our website or contact us for software development services, we may collect personal information such as your name, email address, phone number, company name, and details regarding your business software requirements.
        </p>

        <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--primary-navy); margin-bottom: 1rem;">2. How We Use Your Information</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
            We collect personal information solely to respond to your inquiries, schedule product demonstrations, deliver custom software solutions, and communicate operational updates regarding our services.
        </p>

        <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--primary-navy); margin-bottom: 1rem;">3. Data Security</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
            We employ industry-standard encryption, rate-limiting, secure databases, and access control policies to protect your personal data against unauthorized access, alteration, or disclosure.
        </p>

        <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--primary-navy); margin-bottom: 1rem;">4. Third-Party Disclosure</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
            We do not sell, trade, or transfer your personally identifiable information to outside third parties without your explicit consent, except as required by Australian law.
        </p>

        <h3 style="font-size: 1.4rem; font-weight: 800; color: var(--primary-navy); margin-bottom: 1rem;">5. Contact Us</h3>
        <p style="color: var(--text-muted);">
            If you have questions regarding this Privacy Policy, please email our Data Privacy Officer at <a href="mailto:privacy@globocon.com.au" style="font-weight: 700; color: var(--accent-blue);">privacy@globocon.com.au</a>.
        </p>

    </div>
</section>
